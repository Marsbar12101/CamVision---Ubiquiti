[Unit]
Description=CamViewer web app
After=network-online.target go2rtc.service
Wants=network-online.target
Requires=go2rtc.service

[Service]
Type=simple
WorkingDirectory=/home/pi/camviewer
ExecStart=/usr/bin/node /home/pi/camviewer/server.js
Restart=on-failure
RestartSec=3
User=pi
Environment=PORT=3000
Environment=GO2RTC_API=http://127.0.0.1:1984

[Install]
WantedBy=multi-user.target
